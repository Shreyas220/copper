[Unit]
Description=copper VM networks, host side: NAT to the internet, nothing private
Documentation=https://github.com/Shreyas220/copper/blob/main/docs/design.md#networking
# After Docker, so its DOCKER-USER chain exists to add to.
After=network-online.target docker.service
Before=ingot.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/copper/net.env
ExecStart=/usr/local/lib/copper/copper-net start
ExecStop=/usr/local/lib/copper/copper-net stop

[Install]
WantedBy=multi-user.target
